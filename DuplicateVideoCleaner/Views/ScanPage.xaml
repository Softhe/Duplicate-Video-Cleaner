<UserControl x:Class="DuplicateVideoCleaner.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DuplicateVideoCleaner.Views"
             AutomationProperties.Name="Scan workspace">
  <UserControl.Resources>
    <views:VisibleWhenConverter x:Key="Visible" />
    <views:VisibleWhenConverter x:Key="Hidden" Invert="True" />
    <!-- One settings row: title + description on the left, control on the right -->
    <Style TargetType="Grid" x:Key="SettingRow">
      <Setter Property="MinHeight" Value="66" />
      <Setter Property="Margin" Value="16,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="760" Margin="40,30,40,28">
      <TextBlock Text="Scan for duplicates" Style="{StaticResource TitleText}" />
      <TextBlock Text="Find recordings saved seconds apart and pick one to keep from each group." Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

      <!-- Source: drop zone with the path box and Browse… -->
      <Border x:Name="DropZone" Margin="0,24,0,0" Padding="24,22" CornerRadius="{StaticResource OverlayCorner}" AllowDrop="True"
              Background="Transparent" AutomationProperties.Name="Folder drop area"
              DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid>
          <Rectangle x:Name="DropOutline" RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4 3" Stroke="{DynamicResource StrongStrokeBrush}"
                     Margin="-24,-22" Opacity="0.55" />
          <StackPanel>
            <TextBlock Style="{StaticResource IconText}" Text="&#xE8DE;" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="Drop a recordings folder here" Style="{StaticResource SubtitleText}" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="Works with OBS, ShadowPlay, Xbox Game Bar and phone clips (.mp4, .mkv)" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center" Margin="0,4,0,16" />
            <Grid MaxWidth="560">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="FolderBox" IsEditable="True" IsTextSearchEnabled="False" FontFamily="{StaticResource MonoFont}" FontSize="13"
                        Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentFolders}"
                        IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Video folder"
                        ToolTip="Paste a folder path, or pick a recent folder" />
              <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}"
                      AutomationProperties.Name="Browse for video folder" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Grouping rules: one card, rows separated by a divider -->
      <Border Margin="0,24,0,0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
              CornerRadius="{StaticResource OverlayCorner}" IsEnabled="{Binding CanEdit}">
        <StackPanel>
          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Time window" />
              <TextBlock Text="Recordings that start within this many seconds of a neighbour are grouped" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Grid Width="104">
                <TextBox x:Name="ThresholdBox" Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Padding="10,5,30,6"
                         LostKeyboardFocus="OnThresholdLostFocus" PreviewKeyDown="OnThresholdKeyDown"
                         AutomationProperties.Name="Duplicate threshold in seconds" />
                <StackPanel HorizontalAlignment="Right" Margin="0,2,4,2">
                  <RepeatButton Command="{Binding IncreaseThresholdCommand}" Height="13" Width="22" Focusable="False" AutomationProperties.Name="Increase time window">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"><TextBlock Style="{StaticResource IconText}" FontSize="8" Text="&#xE70E;" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                  <RepeatButton Command="{Binding DecreaseThresholdCommand}" Height="13" Width="22" Focusable="False" AutomationProperties.Name="Decrease time window">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"><TextBlock Style="{StaticResource IconText}" FontSize="8" Text="&#xE70D;" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </StackPanel>
              </Grid>
              <TextBlock Text="seconds" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Keep in each group" />
              <TextBlock Text="The suggested keeper in each group" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SegmentContainer}" VerticalAlignment="Center" Margin="16,0,0,0"
                    AutomationProperties.Name="File to keep">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Keep" Content="Oldest" IsChecked="{Binding KeepOldest}" AutomationProperties.Name="Keep oldest" />
                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Keep" Content="Newest" IsChecked="{Binding KeepNewest}" AutomationProperties.Name="Keep newest" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Include subfolders" />
              <TextBlock Text="Also scan folders inside the selected folder" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="Include subfolders" />
          </Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid Style="{StaticResource SettingRow}" Margin="16,0,16,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,10">
              <TextBlock Text="Protect clips without a date in the name" />
              <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                         Text="A renamed clip such as “clutch ace final round.mp4” is usually one you meant to keep. It still shows in its group, but can't be ticked for removal." />
            </StackPanel>
            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ProtectUndated}" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="Protect clips without a recording date in the file name"
                      AutomationProperties.HelpText="When on, videos whose names contain no recording date are kept, and only originals with matching metadata or another original nearby can be removed" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Action: Scan videos, or progress with Cancel while scanning -->
      <Grid Margin="0,22,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Hidden}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" MinWidth="130" Padding="16,6,16,7"
                AutomationProperties.Name="Scan videos" IsDefault="{Binding IsVisible, RelativeSource={RelativeSource Self}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <TextBlock Text="Scan videos" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="560"
                     AutomationProperties.Name="{Binding Status, StringFormat=Scan status: {0}}" />
        </StackPanel>
      </Grid>
      <Grid Margin="0,22,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Status, StringFormat=Scan status: {0}}" />
          <ProgressBar Margin="0,8,0,6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                       AutomationProperties.Name="Scan progress" />
          <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource MonoCaptionText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="Cancel scan" Margin="20,0,0,0" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel scan" />
      </Grid>
      <TextBlock Text="Scanning only reads file names and metadata. Nothing is moved until you confirm." Style="{StaticResource TertiaryCaptionText}" Margin="0,14,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
