<UserControl x:Class="DuplicateVideoCleaner.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DuplicateVideoCleaner.Views"
             AutomationProperties.Name="Activity workspace">
  <UserControl.Resources>
    <views:VisibleWhenConverter x:Key="Visible" />
    <views:VisibleWhenConverter x:Key="Hidden" Invert="True" />
    <views:NotConverter x:Key="Not" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="24,20,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Activity &amp; Recovery" Style="{StaticResource TitleText}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="{Binding Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
        <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh recovery" ToolTip="Read the Recovery folders again">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <Button x:Name="MoreButton" Margin="8,0,0,0" Width="34" Padding="0" Click="OnMoreClick" AutomationProperties.Name="More recovery actions" ToolTip="More">
          <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" FontSize="14" />
          <Button.ContextMenu>
            <ContextMenu Placement="Bottom">
              <MenuItem Header="Archive completed history…" Command="{Binding ArchiveHistoryCommand}" AutomationProperties.Name="Archive completed recovery history">
                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE7B8;" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Inspect archived payloads" IsCheckable="True" IsChecked="{Binding InspectArchived}" AutomationProperties.Name="Inspect archived recovery payloads">
                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE73E;"
                                          Visibility="{Binding InspectArchived, Converter={StaticResource Visible}}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Open cleanup log" Command="{Binding OpenLogCommand}" AutomationProperties.Name="Open cleanup log">
                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE8A5;" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="3" Style="{StaticResource Divider}" VerticalAlignment="Top" />

      <!-- Recovery list -->
      <DockPanel Margin="24,16,16,0">
        <Grid DockPanel.Dock="Top">
          <TextBlock Text="Recovery" Style="{StaticResource BodyStrongText}" FontSize="16" />
          <TextBlock Text="{Binding SelectionText}" Style="{StaticResource BodyStrongText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding SelectionText}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="Restore never overwrites another file. Storage is freed only by permanent deletion. Rescan after restoring."
                   Style="{StaticResource TertiaryCaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding RecoveryStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasRecoveryStatus, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding RecoveryStatus, StringFormat=Recovery status: {0}}" />
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="{Binding IsWorking}" Margin="0,8,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />

        <!-- Column header -->
        <Grid DockPanel.Dock="Top" Margin="0,12,0,0" Height="34" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding AllSelected, Mode=OneWay}" Command="{Binding ToggleAllCommand}" IsThreeState="False" Margin="10,0,0,0"
                    AutomationProperties.Name="All recovery files selected" />
          <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Moved" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
          <Border Grid.ColumnSpan="4" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid>
          <TextBlock Text="Nothing in Recovery for this folder." Style="{StaticResource SecondaryText}" Margin="0,24,0,0" HorizontalAlignment="Center"
                     Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
          <ListBox ItemsSource="{Binding Items}" AutomationProperties.Name="Recovery files" KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid x:Name="Row" Background="Transparent" Height="46">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Fill" Grid.ColumnSpan="4" CornerRadius="{StaticResource ControlCorner}" Background="Transparent" />
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="10,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding OriginalPath, StringFormat=Select {0}}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                    <TextBlock Text="{Binding Folder}" Style="{StaticResource MonoCaptionText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding MovedText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                  <Border Grid.ColumnSpan="4" Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                </Grid>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillSelectedBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel>

      <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />

      <!-- Session activity -->
      <DockPanel Grid.Column="2" Margin="20,16,16,0">
        <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource BodyStrongText}" FontSize="16" />
        <TextBlock DockPanel.Dock="Top" Text="This session, newest first. Removals are also written to DuplicateCleanupLog.txt in the scanned folder."
                   Style="{StaticResource TertiaryCaptionText}" TextWrapping="Wrap" Margin="0,4,0,8"
                   AutomationProperties.Name="Activity is current session only; latest 200 entries" />
        <ListBox ItemsSource="{Binding Entries}" AutomationProperties.Name="Current session activity" KeyboardNavigation.TabNavigation="Once">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="Circle" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top" Margin="0,10,12,0" Background="{DynamicResource NeutralTintBrush}"
                        BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1">
                  <TextBlock x:Name="Icon" Style="{StaticResource IconText}" FontSize="12" Text="{Binding Glyph}" HorizontalAlignment="Center"
                             Foreground="{DynamicResource NeutralBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,10,0,10">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" ToolTip="{Binding Detail}" />
                  <TextBlock Text="{Binding TimeText}" Style="{StaticResource TertiaryCaptionText}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Divider}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Success">
                  <Setter TargetName="Circle" Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                  <Setter TargetName="Circle" Property="BorderBrush" Value="Transparent" />
                  <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Caution">
                  <Setter TargetName="Circle" Property="Background" Value="{DynamicResource CautionTintBrush}" />
                  <Setter TargetName="Circle" Property="BorderBrush" Value="Transparent" />
                  <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <!-- Actions for the selected Recovery files -->
    <Grid Grid.Row="2">
      <Border Style="{StaticResource Divider}" VerticalAlignment="Top" />
      <Grid Margin="24,14,24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Left" Command="{Binding ToggleAllCommand}" AutomationProperties.Name="Select all recovery files">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE762;" Margin="0,0,8,0" />
            <TextBlock Text="Select all" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource DangerButton}" Command="{Binding PurgeCommand}" AutomationProperties.Name="Permanently delete recovery file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE74D;" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="Permanently delete selected…" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="150" Command="{Binding RestoreCommand}" AutomationProperties.Name="Restore recovery file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE7A7;" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="Restore selected" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
