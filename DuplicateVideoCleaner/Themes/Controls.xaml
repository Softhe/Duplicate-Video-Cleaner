<!--
  Control styles for both themes. Colours are only referenced by key through DynamicResource,
  so ThemeManager can swap Dark.xaml / Light.xaml at runtime. Style rules:
  docs/redesign/mockups/NOTES.md (one accent-filled button per screen, one chip style,
  one badge style, single container level).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Typography -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <CornerRadius x:Key="ControlCorner">4</CornerRadius>
  <CornerRadius x:Key="OverlayCorner">8</CornerRadius>

  <!-- Focus: 2 px outer + 1 px inner, drawn outside the control -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource FocusOuterBrush}" SnapsToDevicePixels="True">
            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource FocusInnerBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock" x:Key="TitleText">
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="SubtitleText">
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="BodyStrongText">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="SecondaryText">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="CaptionText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="TertiaryCaptionText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="MonoCaptionText">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style TargetType="TextBlock" x:Key="IconText">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons -->
  <Style TargetType="Button" x:Key="BaseButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5,12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCorner}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillDisabledBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

  <!-- The one accent-filled action per screen -->
  <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCorner}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource OnAccentDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive actions: standard button with critical text, never accent-filled -->
  <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}" />
  </Style>

  <!-- Transparent buttons: icon buttons, overflow, nav -->
  <Style TargetType="Button" x:Key="SubtleButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCorner}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: a stroked container whose children are SegmentButton / SegmentRadio -->
  <Style TargetType="Border" x:Key="SegmentContainer">
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCorner}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style TargetType="Button" x:Key="SegmentButton" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="12,3,12,4" />
  </Style>
  <Style TargetType="RadioButton" x:Key="SegmentRadio">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="14,3,14,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text box: filled, with a bottom stroke that becomes a 2 px accent line when focused -->
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="10,5,10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlCorner}" />
            <Border x:Name="Underline" VerticalAlignment="Bottom" Height="1" Margin="1,0" CornerRadius="0,0,4,4"
                    Background="{DynamicResource StrongStrokeBrush}" />
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFillFocusedBrush}" />
              <Setter TargetName="Underline" Property="Height" Value="2" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ControlStrokeBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check box: 20 px box, accent fill when checked -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongStrokeBrush}" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="12" HorizontalAlignment="Center"
                         Foreground="{DynamicResource OnAccentBrush}" Text="" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Glyph" Property="Text" Value="&#xE738;" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlFillDisabledBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch (a CheckBox): "On"/"Off" label on the left, 40×20 track on the right -->
  <Style TargetType="CheckBox" x:Key="ToggleSwitch">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
            <TextBlock x:Name="State" Text="Off" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="{DynamicResource ControlFillBrush}"
                      BorderBrush="{DynamicResource StrongStrokeBrush}" />
              <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="State" Property="Text" Value="On" />
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars: a thin rounded thumb, no arrows -->
  <Style TargetType="Thumb" x:Key="ScrollThumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Thumb" CornerRadius="3" Background="{DynamicResource StrongStrokeBrush}" Opacity="0.6" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="RepeatButton" x:Key="ScrollPage">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Margin="4,2">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Scroll viewer without the system-coloured corner square -->
  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress: 1 px track, 3 px accent bar; indeterminate slides a segment across -->
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Height" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot" ClipToBounds="True" SnapsToDevicePixels="True">
            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource StrongStrokeBrush}" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5" Background="{TemplateBinding Foreground}" />
            <Border x:Name="Indeterminate" Width="120" HorizontalAlignment="Left" CornerRadius="1.5" Background="{TemplateBinding Foreground}" Visibility="Collapsed">
              <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-120" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Sliding">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-120" To="900" Duration="0:0:1.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Sliding" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists: subtle hover/selection with a 3 px accent indicator, like the navigation pane -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem" x:Key="SelectableItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource ControlCorner}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,0,0,0"
                      Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillSelectedBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Rows that manage their own look (file rows, recovery rows): no selection chrome -->
  <Style TargetType="ListBoxItem" x:Key="PlainItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combo box (read-only and editable). Drop-down uses the flyout surface. -->
  <Style TargetType="ToggleButton" x:Key="ComboToggle">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE70D;" HorizontalAlignment="Right" Margin="0,0,11,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource ControlCorner}" Margin="4,1">
            <Grid>
              <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillSelectedBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="11,5,34,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlCorner}" />
            <Border x:Name="Underline" VerticalAlignment="Bottom" Height="1" Margin="1,0" Background="{DynamicResource ControlStrokeBottomBrush}" />
            <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="0,0,30,0" Background="Transparent" BorderThickness="0"
                     IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" Margin="11,5,0,6" VerticalAlignment="Center" Focusable="False"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource OverlayCorner}" Padding="0,4" Margin="0,0,8,8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFillBrush}" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource StrongStrokeBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEditable" Value="True" />
                <Condition Property="IsKeyboardFocusWithin" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputFillFocusedBrush}" />
              <Setter TargetName="Underline" Property="Height" Value="2" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Overflow menus -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource OverlayCorner}" Padding="0,4" Margin="0,0,8,8" MinWidth="220">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28" />
            </Border.Effect>
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource ControlCorner}" Margin="4,1" Padding="11,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="0,4" Background="{DynamicResource DividerBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource ControlCorner}" Padding="9,6" MaxWidth="420">
            <ContentPresenter TextElement.FontSize="12">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Confidence chip (the only chip style). Tag: High | Medium | Low | None -->
  <Style TargetType="Border" x:Key="ConfidenceChip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,1,8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NeutralTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBrush}" />
    <Setter Property="TextElement.FontSize" Value="11.5" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="High">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="Medium">
        <Setter Property="Background" Value="{DynamicResource CautionTintBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="Low">
        <Setter Property="Background" Value="{DynamicResource CriticalTintBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- File role badge (the only badge style). Tag: Keep | Remove | Protected -->
  <Style TargetType="Border" x:Key="RoleBadge">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1,7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NeutralBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnBadgeBrush}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="Keep">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="Remove">
        <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Divider line -->
  <Style TargetType="Border" x:Key="Divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
</ResourceDictionary>
